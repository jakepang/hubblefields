# Copy to .env.local for local overrides, or set in Vercel project settings.

# Local default (no env needed): file:./data/t5.sqlite via db/index.ts

# Production (Turso) — required on Vercel
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token

# Seed: set SEED_MANPOWER=0 for a clean trial DB (admin only, no T5 sample workers)
# SEED_MANPOWER=0

# Geofence mode: site | singapore | off
# Use NEXT_PUBLIC_ so the phone UI and API stay in sync.
# - site: tight project polygon (T5)
# - singapore: whole Singapore (dispersed small contractors)
# - off: GPS recorded but always allowed
# NEXT_PUBLIC_GEOFENCE_MODE=singapore
# GEOFENCE_MODE=singapore
# GEOFENCE_LAT=1.322299
# GEOFENCE_LNG=103.990621
# GEOFENCE_RADIUS_M=250
# GEOFENCE_LABEL=Your Company Site
# GEOFENCE_ADDRESS=Singapore
# GEOFENCE_STRICT=false

# Cookies on HTTPS (auto on Vercel; set explicitly if needed)
# COOKIE_SECURE=true

# Firebase Storage (Singapore / asia-southeast1) — required for lasting photo storage on Vercel
# Local /api/uploads fallback does NOT persist on Vercel serverless.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
